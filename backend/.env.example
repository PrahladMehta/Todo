NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/todo_app
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/todo_app_test

APP_TIMEZONE=Asia/Kolkata

JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string_32
JWT_REFRESH_TTL_DAYS=30
OAUTH_STATE_SECRET=replace_me_with_a_third_long_random_string_32

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL=info

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_WINDOW_MINUTES=15
